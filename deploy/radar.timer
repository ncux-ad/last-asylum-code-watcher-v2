# Раз в 2 часа, сознательно снижено с исходных 30 минут — см. RUNBOOK.md
# → «Известные грабли» (GitHub забанил аккаунт за слишком частый скрапинг).
[Unit]
Description=Run Last Asylum Code Radar every 2 hours

[Timer]
OnCalendar=0/2:00:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
