# systemd --user unit. Установка: см. README.md → «Продакшен: self-hosted».
#   mkdir -p ~/.config/systemd/user
#   cp deploy/radar.service deploy/radar.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now radar.timer
#   loginctl enable-linger "$(whoami)"   # переживает выход из SSH-сессии
[Unit]
Description=Last Asylum Code Radar (scan + notify)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/last-asylum-code-watcher-v2
ExecStart=%h/last-asylum-code-watcher-v2/.venv/bin/python -m watcher
# Публикация актуальных кодов на fenix-clan.ru/promocodes/. Ключ ограничен
# forced-command'ом на стороне hosting_vds — умеет только перезаписать
# один файл (state.json), больше ничего. -ExecStart с ведущим "-" не
# валит весь юнит, если сеть/хост временно недоступны.
ExecStart=-/bin/sh -c 'ssh -i %h/.ssh/keys/id_ed25519_senko_to_hostingvds_fenix -o BatchMode=yes -o ConnectTimeout=10 -p 2022 tot@charcoal-pezzottaite18418.my-vm.work < %h/last-asylum-code-watcher-v2/data/state.json'
